#compdef xdg-migrate

_arguments -s -S \
	'(-h --help)'{-h,--help}'[show help]' \
	'(-d --dry-run)'{-d,--dry-run}'[print without executing]' \
	'(-s --symlink)'{-s,--symlink}'[symlink SRC to DST after migrating]' \
	'(-a --auto)'{-a,--auto}'[only migrate in interactive shells]' \
	'(-e --env)'{-e,--env}'[like --auto; unset VAR when nothing was migrated]:variable:_parameters -g "*export*"' \
	'1:source path:_files' \
	'2:destination path:_files'
