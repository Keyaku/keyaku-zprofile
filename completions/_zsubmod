#compdef zsubmod

local -a names reply
local name vpath url branch
_zvendor_entries && for name vpath url branch in $reply; do names+=($name); done

_arguments -s -S \
	'(- *)'{-h,--help}'[show help]' \
	'*--on[enable the submodules that follow]' \
	'*--off[disable the submodules that follow]' \
	'*:submodule:compadd -a names'
